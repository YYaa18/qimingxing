; Engine configuration file.
; Best edited using the Godot Editor, or directly via text for Qimingxing MVP 6.0.

config_version=5

[application]

config/name="Qimingxing Desktop Body"
config/description="启明星（Qimingxing）Godot 4 透明桌面真身"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[display]

window/size/viewport_width=420
window/size/viewport_height=500
window/size/borderless=true
window/size/transparent=true
window/size/always_on_top=true
window/size/resizable=false
window/per_pixel_transparency/allowed=true
window/subwindows/embed_subwindows=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
viewport/transparent_background=true
